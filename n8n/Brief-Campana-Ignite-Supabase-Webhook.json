    {
      "id": "c1a2b3c4-0006-4b01-90e6-brief0000006",
      "name": "Armar Placeholders del Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 180],
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nfunction joinArr(v) {\n  if (Array.isArray(v)) return v.filter(Boolean).join(' · ');\n  return v || '';\n}\n\nfunction orEmpty(v) {\n  const s = (v === null || v === undefined) ? '' : String(v).trim();\n  return s === '' ? '— sin completar —' : s;\n}\n\nconst placeholders = {\n  '{{ID_BRIEF}}': item.id || '',\n  '{{FECHA}}': item.fecha_creacion || '',\n  '{{NOMBRE_CAMPANA}}': orEmpty(item.nombre_campana),\n  '{{SOLICITADO_POR}}': orEmpty(item.solicitado_por),\n  '{{EMAIL_SOLICITANTE}}': orEmpty(item.email_solicitante),\n  '{{CONTEXTO}}': orEmpty(item.contexto),\n  '{{OBJETIVOS}}': orEmpty(joinArr(item.objetivos)),\n  '{{OBJETIVO_OTRO}}': orEmpty(item.objetivo_otro),\n  '{{AUDIENCIA_DEMOGRAFICA}}': orEmpty(item.audiencia_demografica),\n  '{{AUDIENCIA_GEOGRAFICA}}': orEmpty(item.audiencia_geografica),\n  '{{AUDIENCIA_PSICOGRAFIA}}': orEmpty(item.audiencia_psicografia),\n  '{{AUDIENCIA_COMPORTAMIENTOS}}': orEmpty(item.audiencia_comportamientos),\n  '{{ETAPA_EMBUDO}}': orEmpty(item.etapa_embudo),\n  '{{PAGINA_DESTINO}}': orEmpty(item.pagina_destino),\n  '{{CANALES}}': orEmpty(joinArr(item.canales)),\n  '{{ENTREGABLES}}': orEmpty(joinArr(item.entregables)),\n  '{{ENTREGABLE_OTRO}}': orEmpty(item.entregable_otro),\n  '{{MENSAJE_CENTRAL}}': orEmpty(item.mensaje_central),\n  '{{MENSAJE_PRINCIPAL}}': orEmpty(item.mensaje_principal),\n  '{{PIEZAS_TITULARES}}': orEmpty(item.piezas_titulares),\n  '{{MENSAJES_SECUNDARIOS}}': orEmpty(item.mensajes_secundarios),\n  '{{LLAMADOS_ACCION}}': orEmpty(item.llamados_accion),\n  '{{DIRECCION_CREATIVA}}': orEmpty(item.direccion_creativa),\n  '{{PREFERENCIAS_IDENTIDAD}}': orEmpty(joinArr(item.preferencias_identidad)),\n  '{{PREFERENCIAS_OTRO}}': orEmpty(item.preferencias_otro),\n  '{{ELEMENTOS_MARCA}}': orEmpty(joinArr(item.elementos_marca)),\n  '{{INFORMACION_ADICIONAL}}': orEmpty(item.informacion_adicional),\n  '{{RECURSOS_CLAVE}}': orEmpty(item.recursos_clave),\n  '{{ESTADO}}': orEmpty(item.estado)\n};\n\nconst docsApiRequests = Object.entries(placeholders).map(([text, replaceText]) => ({\n  replaceAllText: {\n    containsText: { text, matchCase: true },\n    replaceText\n  }\n}));\n\nreturn [{\n  json: {\n    ...item,\n    docsApiRequests\n  }\n}];"
      }
    },
